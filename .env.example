# 阿里百炼 DashScope（https://bailian.console.aliyun.com/ 创建 API-KEY）
DASHSCOPE_API_KEY=sk-replac…here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方（纯文本，OpenAI 兼容；模型名以 deepseek 开头时自动走这里）
# 未配置 DASHSCOPE_API_KEY 时，analyze 会降级为只用文字描述生成
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型选择（按模型名前缀自动选通道：deepseek-* 走 DeepSeek，其余走百炼）
# 换 embedding 模型会改变向量空间，旧向量会被判定失效并自动重算（见 items.embedding_model）
VLM_MODEL=qwen3.8-omni-flash
LLM_MODEL=qwen3.8-omni-flash
EMBEDDING_MODEL=qwen3.7-text-embedding

# 超时（毫秒）：文本默认 30s，识图默认 90s
AI_TIMEOUT_MS=30000
AI_VISION_TIMEOUT_MS=90000

# 本地
DATABASE_PATH=./data/campus.db
SESSION_SECRET=replac…ring
# 注册第一个账号时设为 1，该账号自动成为管理员
FIRST_USER_IS_ADMIN=0
